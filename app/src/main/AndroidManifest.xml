<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera.any" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
        </intent>
        <package android:name="com.android.documentsui" />
        <package android:name="com.google.android.documentsui" />
    </queries>

    <application
        android:name=".MelonDSApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appName}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="true"
        android:isGame="true"
        android:theme="@style/AppTheme">

        <meta-data
            android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />

        <activity
            android:name=".ui.settings.RestartAppActivity"
            android:process=":restart"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <activity
            android:name=".ui.romlist.RomListActivity"
            android:theme="@style/SplashTheme"
            android:launchMode="singleTop"
            android:exported="true" />
        <activity-alias
            android:name="${applicationId}.DefaultIcon"
            android:targetActivity=".ui.romlist.RomListActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="${appName}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="${applicationId}.AltIcon"
            android:targetActivity=".ui.romlist.RomListActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_alt"
            android:label="${appName}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".ui.romdetails.RomDetailsActivity"
            android:parentActivityName=".ui.romlist.RomListActivity"
            android:exported="false">
        </activity>
        <activity
            android:name=".ui.emulator.EmulatorActivity"
            android:theme="@style/EmulatorTheme"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|uiMode"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.LAUNCH_ROM" />
                <action android:name="${applicationId}.LAUNCH_FIRMWARE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".multiplayer.phantom.PhantomActivity"
            android:launchMode="singleTask"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|uiMode"
            android:exported="false" />
        <service
            android:name=".multiplayer.phantom.PhantomCoordinatorService"
            android:exported="false" />
        <service
            android:name=".multiplayer.phantom.PhantomPrimaryService"
            android:process=":phantom_primary"
            android:exported="false" />
        <service
            android:name=".multiplayer.phantom.PhantomPeerService"
            android:process=":phantom_peer"
            android:exported="false" />
        <activity
            android:name=".multiplayer.phantom.PhantomPrimaryActivity"
            android:process=":phantom_primary"
            android:taskAffinity="${applicationId}.phantom_primary"
            android:excludeFromRecents="true"
            android:theme="@style/EmulatorTheme"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|uiMode"
            android:exported="false" />
        <activity
            android:name=".multiplayer.phantom.PhantomPeerActivity"
            android:process=":phantom_peer"
            android:taskAffinity="${applicationId}.phantom_peer"
            android:excludeFromRecents="true"
            android:theme="@style/EmulatorTheme"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|uiMode"
            android:exported="false" />
        <activity
            android:name=".multiplayer.MultiplayerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.romlist.RomListActivity" />
        <activity
            android:name=".ui.dsiwaremanager.DSiWareManagerActivity"
            android:label="@string/dsiware_manager"
            android:parentActivityName=".ui.romlist.RomListActivity"
            android:exported="false">
        </activity>
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:label="@string/title_activity_settings"
            android:parentActivityName=".ui.romlist.RomListActivity"
            android:launchMode="singleTop">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="me.magnum.melonds.ui.romlist.RomListActivity"/>
        </activity>
        <activity
            android:name=".ui.inputsetup.InputSetupActivity"
            android:label="@string/key_mapping"
            android:parentActivityName=".ui.settings.SettingsActivity"
            android:exported="false" >
        </activity>
        <activity
            android:name=".ui.shortcutsetup.ShortcutSetupActivity"
            android:label="@string/rom_shortcut"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.shortcutsetup.DSFirmwareShortcutSetupActivity"
            android:label="DS Firmware"
            android:icon="@mipmap/ic_platform_ds"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.shortcutsetup.DSiFirmwareShortcutSetupActivity"
            android:label="DSi Firmware"
            android:icon="@mipmap/ic_platform_dsi"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.cheats.CheatsActivity"
            android:label="@string/cheats"
            android:exported="false" >
        </activity>
        <activity
            android:name=".ui.layouts.LayoutListActivity"
            android:label="@string/layouts"
            android:parentActivityName=".ui.settings.SettingsActivity"
            android:exported="false">
        </activity>
        <activity
            android:name=".ui.layouts.LayoutSelectorActivity"
            android:label="@string/layouts"
            android:exported="false">
        </activity>
        <activity
            android:name=".ui.layouteditor.LayoutEditorActivity"
            android:theme="@style/EmulatorTheme"
            android:label="@string/layout_editor"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|uiMode" >
        </activity>
        <activity
            android:name=".ui.backgrounds.BackgroundsActivity"
            android:label="@string/backgrounds">
        </activity>

        <receiver
            android:name="me.magnum.melondualds.RetroAchievementsHostOverrideReceiver"
            android:exported="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">

            <meta-data
                    android:name="me.magnum.melonds.initializer.AppForegroundStateTrackerInitializer"
                    android:value="androidx.startup" />

            <meta-data
                android:name="me.magnum.melonds.initializer.CoilInitializer"
                android:value="androidx.startup" />

            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
